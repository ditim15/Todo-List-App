# Copy this file to .env and fill it in. Never commit .env (it's in .gitignore).
# In production, set these in your host's environment settings instead of a file.

# ---------- Required ----------
# Postgres connection string. Hosted databases usually need SSL: add ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/your_db_name"
# Long random string that signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ---------- Server ----------
PORT=4000
# Where the frontend runs. Used for links in emails, and as the allowed CORS origin
# unless CLIENT_ORIGIN is set.
APP_URL=http://localhost:5173
# Optional: allowed frontend origins if different from APP_URL, comma-separated
# (e.g. https://nudge.app,https://www.nudge.app)
CLIENT_ORIGIN=
# Set to 1 when deployed behind a hosting proxy (Render, Railway, Fly, ...), so rate
# limits see each visitor's real IP. Leave empty for local development.
TRUST_PROXY=

# ---------- Email ----------
EMAIL_TRANSPORT=console            # console (default) | ethereal | smtp
EMAIL_FROM="Nudge <reminders@example.com>"
# Only for EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                  # true for port 465
SMTP_USER=
SMTP_PASS=

# ---------- AI assistant (optional) ----------
# Without it the app works normally and the assistant says it's off.
ANTHROPIC_API_KEY=
