# Copy this file to .env and fill it in. Never commit .env (it's in .gitignore).
# In production, set these in your host's environment settings instead of a file.

# ---------- Required ----------
# Postgres connection string. Hosted databases usually need SSL: add ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/your_db_name"
# Long random string that signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ---------- Server ----------
PORT=4000
# Where the frontend runs. Used for links in emails, and as the allowed CORS origin
# unless CLIENT_ORIGIN is set.
APP_URL=http://localhost:5173
# Optional: allowed frontend origins if different from APP_URL, comma-separated
# (e.g. https://doneyet.app,https://www.doneyet.app)
CLIENT_ORIGIN=
# Set to 1 when deployed behind a hosting proxy (Render, Railway, Fly, ...), so rate
# limits see each visitor's real IP. Leave empty for local development.
TRUST_PROXY=
# Set to production when deployed: makes the login cookie Secure (HTTPS only).
NODE_ENV=development
# Only if the frontend and API are on unrelated domains: none (needs HTTPS). The
# default, lax, works for yourapp.com + api.yourapp.com, and for localhost.
COOKIE_SAMESITE=

# ---------- Email ----------
EMAIL_TRANSPORT=console            # console (default) | ethereal | smtp | resend | memory (tests)
# Only for EMAIL_TRANSPORT=resend: sends through Resend's HTTPS API instead of SMTP. Use it
# on hosts that block SMTP ports (Railway's Hobby plan). Create the key in Resend with
# "Sending access" for your verified domain.
RESEND_API_KEY=
EMAIL_FROM="DoneYet? <reminders@example.com>"
# Set to "off" on a second local API server that shares this database, so only one
# server sends task reminders (default on)
REMINDER_SCHEDULER=on
# Where contact-form messages are sent (default support@doneyet.app)
SUPPORT_EMAIL=support@example.com
# Sender for contact-form messages (default "DoneYet? Contact form <SUPPORT_EMAIL>").
# Reminders and account emails keep using EMAIL_FROM. Must be on a domain your SMTP
# provider has verified.
CONTACT_FROM=
# Only for EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                  # true for port 465
SMTP_USER=
SMTP_PASS=

# ---------- AI assistant (optional) ----------
# Without it the app works normally and the assistant says it's off.
ANTHROPIC_API_KEY=
# Spending caps (days are UTC). Once the day's estimated spend reaches the budget, the
# assistant pauses for everyone until the next day. A worst-case message costs about
# $0.01, a typical one much less. Also set a spend limit on the key in the Anthropic
# Console as a backstop.
AI_DAILY_BUDGET_USD=5
# Messages each user can send the assistant per day.
AI_USER_DAILY_MESSAGES=50

# ---------- Cloud backup to Google Drive (optional) ----------
# Lets users back notes folders up to their Google Drive. Off until both are set.
# Create them in Google Cloud Console (see "Cloud Backup" in README.md). The OAuth
# client's authorized redirect URI must be exactly <API_URL>/cloud/google-drive/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The API's public address, used to build that redirect URI (default
# http://localhost:PORT). In production e.g. https://api.doneyet.app
API_URL=
# Encrypts the stored Google tokens. Required in production once Google is set up; in
# development it falls back to one derived from JWT_SECRET. Generate with the command
# under JWT_SECRET. Changing it means everyone reconnects.
CLOUD_TOKEN_KEY=
# Set to "off" on a second local API server that shares this database, so only one
# server runs backups (default on)
CLOUD_SYNC_SCHEDULER=on

# ---------- Tests (optional) ----------
# Database for `npm test`. It is WIPED between tests, so its name must end in _test.
# Defaults to DATABASE_URL with _test added to the database name.
TEST_DATABASE_URL=
